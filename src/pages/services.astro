---
const options = [ // Guardamos en un array toda la informacion de cada modalidad
{
    titulo: 'Visualizer simple',
    descripcion: 'Una sola escena, con un fondo sencillo, un personaje, algunos efectos, animaciones en loop, lyrics simples.',
    precio: 'Entre 100 y 500€.',
    tiempo: 'De 1 a 2 semanas.',

    gif: "/services/frenesisi.JPG",
    alt: 'ejemplo_visualizer_simple'

},

{
    titulo: 'Visualizer complejo',
    descripcion: 'Con loops de animación adaptados a la canción, sincronización con la música, lyrics animados, cambios de plano y efectos.',
    precio: 'Entre 500 y 1500€.',
    tiempo: 'De 2 a 3 semanas.',

    gif: "/services/rayquaza.gif",
    alt: 'ejemplo_visualizer_complejo'

},

{
    titulo: 'Videoclip',
    descripcion: 'Con cambios de escena, animaciones elaboradas, efectos, lyrics integrados en la escena y animados, escenarios complejos.',
    precio: 'A partir de 1500€',
    tiempo: ' Más de 3 semanas.',

    gif: "/services/lasVegas.gif",
    alt: 'ejemplo_videoclip'

}
];



import Layout from '../layouts/Layout.astro';
---

<Layout>
    <div class="w-full max-w-[70%] md:max-w-full mx-auto px-2"> <!-- Contenedor para ajustar el tamaño en movil -->
        <div class="flex flex-col items-center justify-center gap-10 mt-20 text-white leading-relaxed">

            <div class="flex flex-col gap-3 mt-5 items-center"> <!-- Titulo -->
                <h1 class="anim-title md:text-5xl lg:text-5xl text-3xl font-bold" data-trigger="immediate">Nuestros servicios</h1>

                <span class="anim-color-bar invisible h-1 rounded-full md:w-100 lg:w-100 w-60 bg-purple-600 shadow-[0_0_12px_#d666ff,0_0_12px_#d666ff]" 
                data-trigger="immediate"></span>

            </div> 

            <div class="anim-project-card grid md:grid-cols-2 grid-cols-1 w-full h-full max-w-5xl mt-5 gap-25 items-center" 
            data-trigger="immediate"> <!-- Descripciones y gifs -->
                
                {options.map((op) => (
                <div class="flex flex-col w-full items-center rounded-4xl md:p-5 p-6 gap-2 border border-purple-800 transition-all duration-300 hover:scale-105 hover:border-cyan-500 hover:shadow-2xl shadow-cyan-500/50"
                style={{ background: 'linear-gradient(150deg, #e8e6e3 0%, #8FC4C4 10%, #337EA6 30%, #4F3168 60%, #1c141c 95%, #050506 100%)' }} >
                    
                    <h2 class="font-bold text-3xl text-center"> {op.titulo} </h2>

                    <ul class="list-disc list-inside text-center w-full">
                        <li> {op.descripcion}</li>
                        <li>{op.precio}</li>
                        <li>{op.tiempo}</li>
                    </ul>

                </div>

                <div class="rounded-full">
                    <img src={op.gif}
                    alt={op.alt}>
                </div>
                
                ))}
            </div>

        </div>
    </div>
</Layout>



<script>

    import '../scripts/animaciones.js'; // Importamos las animaciones para los textos

</script>
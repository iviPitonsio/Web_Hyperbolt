---
const proyectos = [ // Creamos un array con todos los proyectos hechos y su informacion
  {
    titulo: 'Las Vegas',
    descripcion: 'Videoclip para el artista Acereda en el que mezclamos el 2D y el 3D con una ambientación basada en un casino de Las Vegas.',
    videoID: 'C3Ia4-RBNl4', // Se añade el ID del video de Youtube en lugar del enlace, para que el componente YouTube funcione bien

    charact: [
		{tipo: 'Videoclip', dimensiones: '2D, 3D' },
  	],
    
  },

  {
    titulo: 'Hazte con Todos',
    descripcion: 'Videoclip para el artista Aledial en el que buscamos acompañar su tema con una ambientación especial y macarra.',
    videoID: 'nW2h6YLNPEc', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '3D' },
  	],
    
  },

  {
    titulo: 'Nadie Más',
    descripcion: 'Videoclip para el artista Acereda donde quisimos celebrar su último tema con una pequeña historia.',
    videoID: 'GOZ-Spw9gg4', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '2D' },
  	],
    
  },

  {
    titulo: 'Hiperrayo',
    descripcion: 'Visualizer para el artista Aledial, protagonizado por el Pokémon Rayquaza.',
    videoID: 'TllD0b8ze0E', 

    charact: [
		{tipo: 'Visualizer', dimensiones: '3D' },
  	],
    
  },

  {
    titulo: 'HeartGold',
    descripcion: 'Videoclip para el artista Aledial, en el que un caballero con un corazón de oro reflexiona sobre el amor.',
    videoID: 's9DY0UrtAmo', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '3D' },
  	],
    
  },

  {
    titulo: 'Dialga',
    descripcion: 'Videoclip para el artista Aledial, en el que un caballero protege lo más importante.',
    videoID: 'nQVFfnrnzGA', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '3D' },
  	],
    
  },


];

import Layout from '../layouts/Layout.astro';
import { YouTube } from 'astro-embed';

---

<Layout>
    <div class="w-full max-w-[70%] md:max-w-full mx-auto px-2"> <!-- Envolvemos todo el contenido en un contenedor que reducira el tamaño de todo para adpatarlo a movil -->

        <div class="flex flex-col items-center justify-center gap-5 mt-20 text-white leading-relaxed">

            <div class="flex flex-col gap-3 items-center mt-5"> <!-- Contenedor del primer titulo -->
                <h1 style="visibility: hidden;" class="anim-title md:text-5xl lg:text-5xl text-3xl font-bold text-center" data-trigger="immediate"> Nuestra Demoreel</h1>
                <span class="anim-color-bar invisible h-1 rounded-full md:w-100 lg:100 lg:w-100 w-60 bg-blue-700 shadow-[0_0_12px_#66b7c3,0_0_12px_#66b7c3]" data-trigger="immediate"
                ></span>

            </div>

            <div class="anim-project-card invisible h-full w-full max-w-2xl mt-10 justify-items-center z-20" data-trigger="immediate"> <!-- Contenedor de la demo reel -->

                <YouTube
                    id={'QLmRJXFZDJs'} 
                    class="aspect-video w-full object-cover object-top h-full relative transition-all duration-300 rounded-2xl border border-purple-800 overflow-hidden hover:scale-105 hover:border-cyan-500 hover:shadow-2xl shadow-cyan-500/50"
                />
                
            </div>

            <div class="flex flex-col gap-3 items-center mt-20">
                <h1 style="visibility: hidden;" class="anim-title md:text-5xl lg:text-5xl text-3xl font-bold" data-trigger="scroll">Proyectos</h1>
                <span class="anim-color-bar invisible h-1 rounded-full md:w-60 lg:60 w-35 bg-blue-700 shadow-[0_0_12px_#66b7c3,0_0_12px_#66b7c3]" 
                data-trigger="scroll"></span>
            </div>

            <!-- Contenedor para todos los proyectos -->
            <div class="anim-project-card invisible will-change-transform grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-7xl mt-10 justify-items-center rounded-4xl z-20"
            data-trigger="scroll">

                {proyectos.map((pro) => ( // Recorremos el array de proyectos y mostramos toda la información 
                    
                    <div class=" text-white rounded-2xl border border-purple-800 overflow-hidden transition-all duration-300 hover:scale-105 hover:border-cyan-500 hover:shadow-2xl shadow-cyan-500/50 h-full w-full"
                    style={{ background: 'linear-gradient(170deg, #e8e6e3 0%, #8FC4C4 30%, #337EA6 60%, #4F3168 70%, #1c141c 95%, #050506 100%)' }} >

                        <!-- Colocamos el video -->
                        <YouTube
                            id={pro.videoID} 
                            class="w-full h-auto object-contain relative"
                        />

                        <div class="flex flex-col items-center p-5">

                            <h3 class="font-bold items-center text-center text-2xl">{pro.titulo}</h3> <!-- Titulo -->

                            <div class="flex flex-row gap-3 p-5 justify-center items-center"> <!-- Caracteristicas -->
                                {pro.charact.map((char) => (

                                        <div class="rounded-2xl p-2 gap-2 text-xs bg-gray-800 items-center border border-white">
                                            {char.tipo}
                                        </div>
                                        <div class="rounded-2xl p-2 gap-2 text-xs bg-gray-800 items-center border border-white">
                                            {char.dimensiones}
                                        </div>
                                
                                ))}
                            </div>

                            <p class="text-justify leading-relaxed">{pro.descripcion}</p> <!-- Descripcion -->

                        </div>      

                    </div>
                    
                ))}

            </div>
        </div>
    </div>
</Layout>

<script>

    import '../scripts/animaciones.js';
        
</script>
---
import Layout from '../layouts/Layout.astro';
import AboutMe from '../components/AboutMe.astro';
import Work from '../components/OurWork.astro';
import Services from '../components/Services.astro'; 
import Contact from '../components/Contact.astro';   
import { ClientRouter } from 'astro:transitions';

---

<Layout>
    <ClientRouter />

    <section class="h-screen relative overflow-hidden block">

        <video class="absolute inset-0 w-full h-full object-cover" autoplay loop muted playsinline preload="auto" poster="/HyperboltReel_v01.webm">
            <source src="/HyperboltReel_v01.webm" type="video/webm">
        </video>

    </section>

    <AboutMe/>

    <div class="mt-25"/>

    <Work/>
    
    <div class="mt-25"/>
    
    <Services/>

    <Contact/>

</Layout>

---
import Layout from '../layouts/Layout.astro';
import AboutMe from '../components/AboutMe.astro';
import Work from '../components/OurWork.astro';
import Services from '../components/Services.astro'; 
import Contact from '../components/Contact.astro';   
import { ClientRouter } from 'astro:transitions';

---

<Layout>
    <ClientRouter /> <!-- Mejora del rendimiento -->

    <section class="h-screen relative overflow-hidden block"> <!-- Bloque que contiene el video de fondo -->

        <video class="absolute inset-0 w-full h-full object-cover" autoplay loop muted playsinline preload="auto" poster="/poster.png">
            <source src="/HyperboltReel_v01.webm" type="video/webm">
        </video>

    </section>

    <AboutMe/> <!-- Bloque de AboutMe -->

    <div class="mt-25"/>

    <Work/> <!-- Bloque de trabajos -->
    
    <div class="mt-25"/>
    
    <Services/> <!-- Bloque de servicios -->

    <Contact/> <!-- Bloque de contacto -->

</Layout>

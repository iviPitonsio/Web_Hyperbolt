---
import '../styles/global.css' 
import { Icon } from 'astro-icon/components';
import Menu from '../components/Menu.astro';
---

<header class="fixed top-0 z-50 w-full">

    <nav class="flex flex-row items-center bg-black text-white min-h-20">

    <div class="lg:hidden xl:hidden 2xl:hidden ml-5">

            <div class="flex flex-row">
                
                <input type="checkbox" id="menu-toggle" class="peer hidden"/>
                
                <label for="menu-toggle" class="flex flex-col gap-1 cursor-pointer z-50"> <!-- Hamburger menu -->
                    <span class="w-6 h-0.5 bg-white"></span>
                    <span class="w-6 h-0.5 bg-white"></span>
                    <span class="w-6 h-0.5 bg-white"></span>

                </label>
            

                <div class="hidden peer-checked:flex flex-col bg-[color-mix(in_srgb,var(--color-black)_70%,transparent)] font-bold text-2xl text-white fixed inset-0 items-center justify-center gap-6 z-40">
    
                    <Menu/>
                
                </div>
            
            </div>
            
        </div>

    <div class="flex flex-row px-4 items-center gap-3 bg-black shadow-md ">
        
        <div class="flex flex-row gap-3 items-center shrink-0">
            <img src="src/assets/HB_Color_NoBG.png" alt="Logo" class="h-12 w-12" />
            <h1 class="text-xl font-bold mb-1">Hyperbolt Studio</h1>
        </div>

        <div class="hidden lg:flex flex-row gap-6 xl:gap-8 ml-auto md:mr-15 w-full md:w-auto md:ml-auto pb-2 md:pb-0 no-scrollbar absolute right-0">

            <div class="flex flex-row items-center gap-8">
                
                <Menu/>
            
            </div>
        
        </div>
    
    </div>

    </nav>

</header>





---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<div class="flex flex-col items-center justify-center gap-10 mt-20 text-white leading-relaxed">

    <div class="flex flex-col gap-2 items-center">
        <h1 id="contact" class="md:text-5xl lg:text-5xl text-4xl font-bold scroll-mt-25">Contacto</h1>

        <span id="sub06" class="h-1 rounded-full md:w-50 lg:w-50 w-40 bg-purple-800 shadow-[0_0_12px_#7e1ec3,0_0_12px_#7e1ec3]"></span>
    </div>

    <div id="para03">
        <p class="text-justify md:max-w-3xl mx-auto max-w-65">
            Puedes contactarnos por el correo que tienes aquí abajo correo o a través del siguiente formulario, ¡no te cortes y dinos lo que quieras!</p>
    
        <p class="text-center font-bold md:text-2xl lg:text-2xl text-xl mt-5 transition-all duration-300 hover:scale-105">studioshyperbolt@gmail.com</p>
        
    </div>

    <div id="form" class="flex justify-center text-white bg-black border border-white rounded-2xl md:w-90 lg:w-90 w-70 p-3">
        <form class="flex flex-col gap-2 w-md autofill:shadow-[0_0_0_1000px_#000000_inset] autofill:text-fill-white"

            action="https://api.web3forms.com/submit" 
            method="POST" 
            id="contact-form">

            <input type="hidden" name="access_key" value={web3formsKey} />

            <label>Nombre y apellidos</label>
            <input type="text" id="name" name="Nombre_y_apellidos" class="border border-white rounded-md"/>

            <label>Email</label>
            <input type="email" id="email" name="email" class="border border-white rounded-md"/>

            <label>Mensaje</label>
            <textarea name="mensaje" class="border border-white rounded-md h-40"> </textarea>

            
            <button type="submit" class="w-full h-15 cursor-pointer bg-blue-600 text-white rounded-2xl mt-3 text-center px-2 py-3 border border-blue-900 transition-all duration-300 hover:scale-105"> Enviar </button>

        </form>
        
    </div>

</div>

<script>

import SplitType from "split-type";
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

function ejecutarAnimacion() {

    let contText = new SplitType('#contact');
    
    
    gsap.from(contText.chars, {
        y: '100%',
        stagger: 0.05,
        delay: 0.2,
        duration: 0.5,
        ease: 'power2.out',
        autoAlpha: 0,

        scrollTrigger: {
            trigger: "#contact",
            start: "top 100%",
    }
    });

    gsap.fromTo('#form', {
        x: '-300%'
        },
        {
        x:0,
        delay: 1.0,
        duration: 1.5,
        ease: 'power2.out',
        autoAlpha: 1,
        clearProps: 'transform',
        scrollTrigger: {
            trigger: "#para03",
            start: "bottom 100%",

    }
    });

    gsap.from('#para03', {
        y: '100%',
        delay: 1.0,
        duration: 1.0,
        ease: 'power2.out',
        autoAlpha: 0,
        scrollTrigger: {
            trigger: "#contact",
            start: "bottom 100%",

    }
    });

    gsap.from('#sub06', {
        y: '100%',
        delay: 0.8,
        duration: 1.0,
        autoAlpha: 0,
        scrollTrigger: {
            trigger: "#contact",
            start: "top 85%",

    }
    });

    ScrollTrigger.refresh();
}

document.addEventListener('astro:page-load', ejecutarAnimacion);

document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach(trigger => trigger.kill());
});


</script>
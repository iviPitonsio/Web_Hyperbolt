---
import '../styles/global.css' 

---

<div class="fixed isolate overflow-hidden z-[-2] h-screen min-h-screen w-full overflow-x-hidden">
  // Faded Pine — duo

<div class="absolute inset-0 -z-0" style={{ background: 'linear-gradient(182deg, #e8e6e3 0%, #c4988f 10%, #b53c57 46%, #683153 54%, #1c141c 87%, #050506 100%)' }} />
  <div class="absolute -z-1" style={{
    inset: '0px',
    backgroundImage: 'repeating-linear-gradient(104deg, transparent 0 20px, rgba(216, 49, 86, 0.33) 20px 22px, transparent 22px 40px), repeating-linear-gradient(164deg, transparent 0 30px, rgba(228, 215, 210, 0.19) 30px 32px, transparent 32px 60px)',
    filter: 'blur(25px)',
    opacity: 0.196
  }} />
  <div class="absolute inset-0 -z-2" style={{ background: 'radial-gradient(ellipse at 48% 5%, rgba(255,255,255,0.22), transparent 38%), radial-gradient(ellipse at 49% 46%, rgba(216, 49, 86, 0.27), transparent 42%)' }} />
  <div class="absolute inset-0 -z-4" style={{ background: 'radial-gradient(circle at center, transparent 25%, rgba(0,0,0,0.2) 58%, rgba(0,0,0,0.91) 100%), linear-gradient(to bottom, transparent 45%, rgba(0,0,0,0.85) 100%)' }} />
  <div class="absolute inset-0 -z-5 mix-blend-soft-light" style={{ opacity: 0.18 }} />

</div>
---
const proyectos = [
  {
    titulo: 'Las Vegas',
    descripcion: 'Videoclip para el artista Acereda en el que mezclamos el 2D y el 3D con una ambientación basada en un casino de Las Vegas.',
    video: 'https://www.youtube.com/embed/C3Ia4-RBNl4', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '2D y 3D' },
  	],
    
  },

  {
    titulo: 'Hazte con Todos',
    descripcion: 'Videoclip para el artista Aledial en el que buscamos acompañar su tema con una ambientación especial y macarra.',
    video: 'https://youtube.com/embed/nW2h6YLNPEc', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '3D' },
  	],
    
  },

  {
    titulo: 'Nadie Más',
    descripcion: 'Videoclip para el artista Acereda donde quisimos celebrar su último tema con una pequeña historia.',
    video: 'https://youtube.com/embed/GOZ-Spw9gg4', 

    charact: [
		{tipo: 'Videoclip', dimensiones: '2D' },
  	],
    
  },


];

import { YouTube } from 'astro-embed';
function getYoutubeId(embedUrl: String) {
  return embedUrl.split('/embed/')[1]?.split('?')[0] ?? '';
}
---
<div class="w-full max-w-[70%] md:max-w-full mx-auto px-2">

    <div class="flex flex-col items-center justify-center gap-5 mt-20 text-white leading-relaxed">

        <div class="flex flex-col gap-3 items-center">
            <h1 id="work" class="md:text-5xl lg:text-5xl text-4xl font-bold">Nuestro trabajo</h1>
            <span id="sub02" class="h-1 rounded-full md:w-90 lg:w-90 w-70 bg-blue-700 shadow-[0_0_12px_#66b7c3,0_0_12px_#66b7c3]"></span>
        </div>

        <div id="projects" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-8 gap-10 w-full max-w-7xl mt-10 justify-items-center rounded-4xl z-20">

            {proyectos.map((pro) => (
                
                <div class=" text-white  rounded-2xl border border-purple-800 overflow-hidden transition-all duration-300 hover:scale-105 hover:border-cyan-500 hover:shadow-2xl shadow-cyan-500/50 h-full w-full"
                style={{ background: 'linear-gradient(170deg, #e8e6e3 0%, #8FC4C4 30%, #337EA6 60%, #4F3168 70%, #1c141c 95%, #050506 100%)' }} >

                    <YouTube
                            id={getYoutubeId(pro.video)}
                            class="aspect-video w-full object-cover object-top md:h-48 h-40 relative"
                        />

                    <div class="flex flex-col items-center p-5">

                        <h3 class="font-bold items-center text-2xl">{pro.titulo}</h3>

                        <div class="flex flex-row gap-3 p-5">
                        {pro.charact.map((char) => (
                            <>
                                <div class="rounded-2xl p-2 gap-2 text-xs bg-gray-800 items-center border border-white">
                                    {char.tipo}
                                </div>
                                <div class="rounded-2xl p-2 gap-2 text-xs bg-gray-800 items-center border border-white">
                                    {char.dimensiones}
                                </div>
                            </>
                        ))}
                    </div>

                        <p class="text-justify leading-relaxed">{pro.descripcion}</p>

                    </div>      

                </div>
                
            ))}
            



        </div>

        
        <div id="button" class=" opacity-0 mt-10">
            <a href="/works" class="block text-white font-bold p-3 bg-black border border-white rounded-4xl transition-all duration-300 hover:scale-105 mt-5">Ver más</a>
        </div>

    </div>
</div>

<script>

import SplitType from "split-type";
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);


function ejecutarAnimacion() {

    let workText = new SplitType('#work');
    
    
    gsap.from(workText.chars, {
        y: '100%',
        stagger: 0.05,
        delay: 0.2,
        duration: 0.5,
        ease: 'power2.out',
        autoAlpha: 0,

        scrollTrigger: {
            trigger: "#projects",
            start: "top 100%",
    }
    });

    gsap.from('#projects', {
        x: '-200%',
        delay: 0.2,
        duration: 1.5,
        ease: 'power2.out',
        autoAlpha: 1,

        scrollTrigger: {
            trigger: "#projects",
            start: "top 70%",
    }

    });

    gsap.to('#buttonWork', {
        y: '-50%',
        delay: 5.0,
        autoAlpha: 1,
        ease: 'power2.out',
        scrollTrigger: {
            trigger: "#projects",
            start: "bottom 70%",
        }
    });

    gsap.from('#sub02', {
        y: '100%',
        delay: 1.0,
        duration: 1.0,
        autoAlpha: 0,
        scrollTrigger: {
            trigger: "#projects",
            start: "top 100%",
    }
    });

    ScrollTrigger.refresh();
    }

    document.addEventListener('astro:page-load', ejecutarAnimacion);

    document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach(trigger => trigger.kill());
    });


</script>